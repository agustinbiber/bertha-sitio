// Configuración de Cloudflare Workers para la web pública de Bertha.
// Solo archivos estáticos (sin código de servidor): se publica lo que está en public/.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bertha",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
